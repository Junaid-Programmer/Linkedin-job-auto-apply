# ------------------------------------------------------------------
# LLM (used for scoring jobs and tailoring resumes)
# Fill these in yourself. The code never reads keys from the agent's
# environment - it only reads these USER_* variables.
# ------------------------------------------------------------------
USER_LLM_API_KEY=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
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------
# Google Sheets
# - GOOGLE_SERVICE_ACCOUNT_FILE: path to the service-account JSON you
#   download from Google Cloud (see README)
# - GOOGLE_SHEET_NAME: the spreadsheet to create/use
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
GOOGLE_SHEET_NAME=Job Tracker
# Optional: point at your exact spreadsheet by ID (from the /d/<ID>/ in the URL)
GOOGLE_SHEET_ID=

# ------------------------------------------------------------------
# Scoring
# Jobs with a score >= SCORE_THRESHOLD get a tailored resume prepared;
# anything below is skipped.
# ------------------------------------------------------------------
SCORE_THRESHOLD=70

# ------------------------------------------------------------------
# LinkedIn search defaults (can be overridden on the command line or by
# `linkedin_location` in rules.yaml)
# ------------------------------------------------------------------
LINKEDIN_SEARCH_KEYWORDS=python developer
LINKEDIN_SEARCH_LOCATION=Europe
LINKEDIN_PAGES=2
# LinkedIn time filter: r86400 = last 24h, r604800 = last week, empty = any
LINKEDIN_TIME_FILTER=r604800
# Saved browser session (created by: python run.py login)
LINKEDIN_STATE_FILE=data/linkedin_state.json
